# 사이트 기본 주소 (sitemap, canonical, OG에 사용).
# Cloudflare 빌드(npm run build:cloudflare)는 비어 있으면 미리보기 주소(twohandsmeta.pages.dev)를 쓴다.
NEXT_PUBLIC_SITE_URL=https://twohandsmeta.pages.dev

# 채널톡 플러그인 키. 비어 있으면 채널톡을 불러오지 않음. TODO
NEXT_PUBLIC_CHANNEL_IO_PLUGIN_KEY=

# 초안(draft: true) 블로그 글을 공개하려면 true
NEXT_PUBLIC_SHOW_DRAFTS=false

# 미팅 예약 링크. TODO
NEXT_PUBLIC_BOOKING_URL=

# 검색엔진 노출. 기본은 차단(noindex). 정식 공개 때만 true (npm run build:cloudflare -- --launch 가 함께 처리)
NEXT_PUBLIC_ALLOW_INDEXING=false
