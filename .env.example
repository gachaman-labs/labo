# 사이트 기본 주소 (sitemap, canonical, OG에 사용). TODO: 도메인 확정 후 교체
NEXT_PUBLIC_SITE_URL=https://example.com

# 채널톡 플러그인 키. 비어 있으면 채널톡을 불러오지 않음. TODO
NEXT_PUBLIC_CHANNEL_IO_PLUGIN_KEY=

# 초안(draft: true) 블로그 글을 운영 환경에서도 노출하려면 true
NEXT_PUBLIC_SHOW_DRAFTS=false

# 미팅 예약 링크. TODO
NEXT_PUBLIC_BOOKING_URL=

# 검색엔진 노출. 기본은 차단(noindex). 정식 공개 때만 true 로 바꾼다.
NEXT_PUBLIC_ALLOW_INDEXING=false
